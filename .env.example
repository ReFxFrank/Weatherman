# NASA FIRMS map key — free, emailed on signup:
#   https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Unlocks the full area API (1–10 day ranges, regional bbox queries, LANDSAT).
# If unset, the proxy falls back to FIRMS's public keyless global feeds
# (still live data, but world-only and 24h/48h/7d windows).
FIRMS_MAP_KEY=

# Port for the Hono API proxy (Vite dev server proxies /api here)
PORT=8787

# EUMETSAT API credentials — free, from https://api.eumetsat.int/api-key/
# (create an EO Portal account, the key pair is on your API-key page).
# Unlocks Meteosat MTG-LI lightning over Europe/Africa on the lightning
# globe. If unset, lightning still works with the two GOES satellites
# (Americas). NEVER log the token-endpoint error body — it echoes the key.
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=
