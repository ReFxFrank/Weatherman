# NASA FIRMS map key — free, emailed on signup:
#   https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Unlocks the full area API (1–10 day ranges, regional bbox queries, LANDSAT).
# If unset, the proxy falls back to FIRMS's public keyless global feeds
# (still live data, but world-only and 24h/48h/7d windows).
FIRMS_MAP_KEY=

# Port for the Hono API proxy (Vite dev server proxies /api here)
PORT=8787
